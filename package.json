{
  "name": "nodejs-rabbitmq",
  "version": "1.0.0",
  "description": "Order placement API with Fastify, RabbitMQ and PostgreSQL",
  "main": "dist/api/index.js",
  "scripts": {
    "dev:api": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:notification": "tsx watch src/notification-worker/index.ts",
    "dev:inventory": "tsx watch src/inventory-worker/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:api": "node dist/api/index.js",
    "start:worker": "node dist/worker/index.js",
    "start:notification": "node dist/notification-worker/index.js",
    "start:inventory": "node dist/inventory-worker/index.js",
    "start:relay": "node dist/outbox-relay/index.js",
    "dev:relay": "tsx watch src/outbox-relay/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "fastify",
    "rabbitmq",
    "typescript",
    "orders"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^6.14.0",
    "amqplib": "^0.10.8",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^6.10.1",
    "pino": "^9.0.0",
    "prisma": "^6.14.0",
    "prom-client": "^15.1.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.7",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^6.4.24",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.20.4",
    "testcontainers": "^10.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
