{
  "name": "nodejs-rabbitmq",
  "version": "1.0.0",
  "description": "Order placement API with Fastify, RabbitMQ and PostgreSQL",
  "main": "dist/api/index.js",
  "scripts": {
    "dev:api": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsc",
    "start:api": "node dist/api/index.js",
    "start:worker": "node dist/worker/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "fastify",
    "rabbitmq",
    "typescript",
    "orders"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "amqplib": "^0.10.8",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/node": "^24.3.0",
    "prisma": "^6.14.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
