{
  "name": "nodejs-rabbitmq",
  "version": "1.0.0",
  "description": "Order placement API with Fastify, RabbitMQ and a pluggable storage (in-memory/redis/postgres)",
  "main": "dist/api/index.js",
  "scripts": {
    "dev": "tsx watch src/api/index.ts",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:notification": "tsx watch src/notification-worker/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/api/index.js",
    "start:api": "node dist/api/index.js",
    "start:worker": "node dist/worker/index.js",
    "start:notification": "node dist/notification-worker/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "fastify",
    "rabbitmq",
    "typescript",
    "orders"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "amqplib": "^0.10.8",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "ioredis": "^6.0.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.7",
    "@types/node": "^24.3.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prisma": "^6.14.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
