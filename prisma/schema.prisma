generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FAILED
}

model Order {
  id           String      @id @default(uuid())
  customerName String
  items        Json
  totalAmount  Decimal     @db.Decimal(10, 2)
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("orders")
}

// Transactional outbox: order + event are written in one DB transaction,
// then a relay publishes the event to RabbitMQ (at-least-once delivery).
model Outbox {
  id            String   @id @default(uuid())
  aggregateType String
  aggregateId   String
  type          String
  payload       Json
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([published, createdAt])
}

// Consumer idempotency: a message id is recorded once, so redeliveries
// (retries, reconnects) are skipped instead of being processed twice.
model ProcessedMessage {
  messageId String   @id
  queue     String
  createdAt DateTime @default(now())
}

// Inventory: stock available for reservation. The inventory worker reserves
// units when an order is placed and releases them on cancellation. Row-level
// locking (SELECT ... FOR UPDATE) keeps concurrent reservations consistent.
model InventoryItem {
  id        String   @id @default(uuid())
  sku       String   @unique
  name      String
  available Int
  reserved  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory_items")
}

// One reservation per order: makes reserve idempotent so consumer retries
// after a partial failure (e.g. publish error) cannot double-decrement stock.
model InventoryReservation {
  orderId   String   @id
  createdAt DateTime @default(now())

  @@map("inventory_reservations")
}
