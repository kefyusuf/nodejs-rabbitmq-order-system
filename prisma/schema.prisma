generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FAILED
}

model Order {
  id           String      @id @default(uuid())
  customerName String
  items        Json
  totalAmount  Decimal     @db.Decimal(10, 2)
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("orders")
}

// Transactional outbox: order + event are written in one DB transaction,
// then a relay publishes the event to RabbitMQ (at-least-once delivery).
model Outbox {
  id            String   @id @default(uuid())
  aggregateType String
  aggregateId   String
  type          String
  payload       Json
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([published, createdAt])
}

// Consumer idempotency: a message id is recorded once, so redeliveries
// (retries, reconnects) are skipped instead of being processed twice.
model ProcessedMessage {
  messageId String   @id
  queue     String
  createdAt DateTime @default(now())
}
