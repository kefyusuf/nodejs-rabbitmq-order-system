# Values below target the Docker Compose network (service hostnames).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/orders?schema=public
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=orders

# For local development outside Docker (infra started via `docker compose up postgres rabbitmq`),
# replace the service hostnames with localhost:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orders?schema=public
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
