# beginner (default): in-memory store, basic topology. No DATABASE_URL needed.
NODE_ENV=development
PORT=3000
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=orders
STORE=in-memory
TOPOLOGY=basic
REDIS_URL=redis://localhost:6379

# mid/hero için örnek (aktif edin):
# STORE=postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orders?schema=public
