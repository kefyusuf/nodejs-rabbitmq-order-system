# Values below target the Docker Compose network (service hostnames).
NODE_ENV=development
PORT=3000
# The app uses the least-privilege `orders_app` role created by
# docker/postgres/init/10-app-role.sql (recreate the volume with
# `docker compose down -v` if you had an older DB).
DATABASE_URL=postgresql://orders_app:orders_app@postgres:5432/orders?schema=public
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=orders

# For local development outside Docker (infra started via `docker compose up postgres rabbitmq`),
# replace the service hostnames with localhost:
# DATABASE_URL=postgresql://orders_app:orders_app@localhost:5432/orders?schema=public
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Hero: JWT auth + observability
JWT_SECRET=dev-insecure-change-me
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Email delivery (notification worker). MAIL_MODE:
#   console -> log the message, do not send (default, zero config)
#   smtp    -> generic SMTP server (set SMTP_HOST/PORT/USER/PASS)
#   resend  -> Resend SMTP relay (set RESEND_API_KEY)
MAIL_MODE=console
MAIL_FROM=orders@example.com
MAIL_TO=customer@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=secret
# RESEND_API_KEY=re_xxx
